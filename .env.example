# =============================================================================
# Variables d'environnement NestSpend - EXEMPLE
# =============================================================================
# Copier ce fichier en .env et remplir les valeurs :
#   cp .env.example .env
#
# IMPORTANT : Ne jamais commiter le fichier .env dans git !
# =============================================================================

# PostgreSQL
POSTGRES_PASSWORD=changeme_strong_password_here

# JWT - Générer avec : openssl rand -base64 64
JWT_SECRET=changeme_generate_a_strong_random_secret_of_at_least_32_chars

# Durée de validité du token JWT en millisecondes (86400000 = 24h)
JWT_EXPIRATION_MS=86400000

# Port de l'API (optionnel, défaut : 8080)
# SERVER_PORT=8080
